# پیکربندی نمونه. مقادیر حساس هرگز در مخزن commit نمی‌شوند.

DAADNO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/daadno
DAADNO_ENVIRONMENT=dev

# §۶ — کلید HMAC شماره موبایل. در پرودکشن اجباری است و اگر مقدار پیش‌فرض
# بماند، بالا آمدن اپ با خطا متوقف می‌شود.
DAADNO_PHONE_HMAC_KEY=dev-only-change-me
DAADNO_JWT_SECRET=dev-only-change-me

# T-102 — تعویض ارائه‌دهنده فقط از همین‌جا، بدون تغییر کد.
DAADNO_EMBEDDING_PROVIDER=hashing
DAADNO_EMBEDDING_DIM=1024
# DAADNO_EMBEDDING_PROVIDER=openai_compatible
# DAADNO_EMBEDDING_API_BASE=https://api.openai.com/v1
# DAADNO_EMBEDDING_API_KEY=
# DAADNO_EMBEDDING_MODEL=text-embedding-3-large

DAADNO_LLM_PROVIDER=heuristic
# DAADNO_LLM_PROVIDER=anthropic
# DAADNO_LLM_API_KEY=
# DAADNO_LLM_MODEL=claude-opus-5

# دروازهٔ pre-flight — روی golden set کالیبره می‌شود (prompts/02_answer.md).
DAADNO_THRESHOLD_ASK=0.016
DAADNO_THRESHOLD_ROUTE=0.008
