# Anthropic API key. If unset, the orchestrator runs in deterministic
# rule-based mode (no LLM calls) — the whole system still works end-to-end.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_EFFORT=low
PORT=8787
# Comma-separated allowed origins for the SDK (CORS). "*" for local dev.
ALLOWED_ORIGINS=*
SESSION_TTL_MINUTES=60
LOG_LEVEL=info
